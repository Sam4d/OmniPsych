rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Private User Profiles & Vectors
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // PII protection
      
      allow create: if isOwner(userId) 
        && isValidId(userId)
        && incoming().uid == request.auth.uid
        && incoming().displayName is string && incoming().displayName.size() <= 100
        && incoming().username is string && incoming().username.size() <= 50;

      allow update: if isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().displayName is string && incoming().displayName.size() <= 100
        && incoming().username is string && incoming().username.size() <= 50;

      allow delete: if isOwner(userId);

      // Friends subcollection
      match /friends/{friendUid} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) 
          && isValidId(friendUid)
          && incoming().friendUid == friendUid
          && incoming().friendUsername is string && incoming().friendUsername.size() <= 50;
        allow update: if isOwner(userId)
          && incoming().friendUid == existing().friendUid;
        allow delete: if isOwner(userId);
      }
    }

    // Public Profiles (for friend discovery, leaderboards & comparison)
    match /public_profiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      
      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().uid == request.auth.uid
        && incoming().displayName is string && incoming().displayName.size() <= 100
        && incoming().username is string && incoming().username.size() <= 50
        && incoming().friendCode is string && incoming().friendCode.size() <= 30;

      allow update: if isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().displayName is string && incoming().displayName.size() <= 100
        && incoming().username is string && incoming().username.size() <= 50;

      allow delete: if isOwner(userId);
    }

    // Compatibility Duels & Invites
    match /compatibility_duels/{duelId} {
      allow get: if isSignedIn() || true; // Allow landing on challenge invite link
      allow list: if isSignedIn() && (
        resource.data.inviterUid == request.auth.uid || 
        resource.data.inviteeUid == request.auth.uid
      );
      
      allow create: if isSignedIn()
        && isValidId(duelId)
        && incoming().duelId == duelId
        && incoming().inviterUid == request.auth.uid
        && incoming().inviterName is string && incoming().inviterName.size() <= 100
        && incoming().status in ['pending', 'completed'];

      allow update: if isSignedIn()
        && incoming().duelId == existing().duelId
        && incoming().inviterUid == existing().inviterUid
        && (
          // Inviter can update
          request.auth.uid == existing().inviterUid ||
          // Invitee can complete the duel
          (
            existing().status == 'pending' &&
            incoming().inviteeUid == request.auth.uid &&
            incoming().status == 'completed'
          )
        );

      allow delete: if isSignedIn() && existing().inviterUid == request.auth.uid;
    }
  }
}
